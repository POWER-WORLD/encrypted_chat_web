# ==============================================================================
# MSG_CRYPT Backend Environment Variables Template
# ==============================================================================

# Server Listening Port (Default: 5000)
PORT=5000

# Node Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Database Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/encrypterData
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Zero-Config Dev: 'memory' runs an embedded in-memory MongoDB with pre-seeded demo users
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Signing Secret Key (Minimum 32 random characters recommended for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production_32chars

# Client Application URL for CORS Policy
# Production: https://encrypted-chats.onrender.com
# Development: http://localhost:5173
CLIENT_URL=https://encrypted-chats.onrender.com
