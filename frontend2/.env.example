# ==============================================================================
# MSG_CRYPT Frontend Environment Variables Template
# ==============================================================================

# Target Backend API Base URL (Protocol included, no trailing slash)
# Development: http://localhost:5000
# Production: https://encrypted-chat-web.onrender.com
# If omitted, defaults automatically based on Vite build mode (development vs production).
VITE_API_BASE_URL=http://localhost:5000

# Cloudinary Storage Configuration (For avatar asset uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
